{
  "name": "maplibre-gl-wind",
  "version": "0.2.1",
  "private": false,
  "description": "Wind particle visualization layer for deck.gl and MapLibre GL JS",
  "keywords": [
    "deck.gl",
    "map",
    "maplibre",
    "particles",
    "visualization",
    "weather",
    "webgl",
    "wind"
  ],
  "homepage": "https://maplibre-gl-wind.geoql.in",
  "bugs": {
    "url": "https://github.com/geoql/maplibre-gl-wind/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Vinayak Kulkarni",
    "email": "inbox.vinayak@gmail.com",
    "url": "https://vinayakkulkarni.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoql/maplibre-gl-wind.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "test": "vp test run",
    "prepare": "is-ci || husky",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt --check",
    "format:fix": "vp fmt --write",
    "typecheck": "vp check --no-fmt --no-lint",
    "demo:dev": "pnpm run build && pnpm --filter maplibre-gl-wind-demo run dev",
    "demo:build": "pnpm run build && pnpm --filter maplibre-gl-wind-demo run build",
    "demo:deploy": "pnpm run build && pnpm --filter maplibre-gl-wind-demo run deploy",
    "publish:npm": "npm publish --access public",
    "publish:jsr": "pnpm dlx jsr publish"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/engine": "^9.4.2",
    "@luma.gl/shadertools": "^9.4.2",
    "@types/node": "^26.6.5",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^17.6.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.4.0"
  },
  "peerDependencies": {
    "@deck.gl/core": ">=9.0.0",
    "@deck.gl/layers": ">=9.0.0",
    "@luma.gl/core": ">=9.0.0",
    "@luma.gl/engine": ">=9.0.0",
    "@luma.gl/shadertools": ">=9.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.x"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
